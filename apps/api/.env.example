# ==============================================================================
# Verelli.lol API (apps/api) — Environment Configuration Template (.env.example)
# Copy this file to apps/api/.env to configure the FastAPI backend server.
# ==============================================================================

# Application Metadata
PROJECT_NAME="verelli.lol API"
VERSION="1.0.0"
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# Supabase Database & pgvector Credentials
# ------------------------------------------------------------------------------
# Supabase project REST URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anonymous API key
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key

# Supabase service role API key (recommended for batch seeding and admin RPCs)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# Third-Party Vector Embedding & LLM Synthesis Providers
# ------------------------------------------------------------------------------
# OpenAI API key (used for text-embedding-3-small and GPT-4o synthesis)
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google Gemini API key (used for Gemini 1.5 Flash / Pro synthesis)
GEMINI_API_KEY=AIzaSy-your-google-gemini-api-key

# ------------------------------------------------------------------------------
# Algorithmic & Security Guardrails
# ------------------------------------------------------------------------------
# Cosine similarity threshold for zero-hallucination boundary (default: 0.65)
SIMILARITY_THRESHOLD=0.65

# Allowed CORS Origins (comma-separated list for cross-origin requests)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://verelli.lol"

# Public API URL alignment with Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
