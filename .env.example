# ==============================================================================
# Verelli.lol — Root Environment Configuration Template (.env.example)
# Copy this file to .env to configure your local development environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase PostgreSQL + pgvector Database Configuration
# ------------------------------------------------------------------------------
# Your Supabase project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key for client-side queries (RLS enforced)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-supabase-anon-key

# Service role secret key for backend administration, seeding, and migrations
# CAUTION: Never expose this key in public client repositories or web bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ------------------------------------------------------------------------------
# AI LLM & Vector Embedding Providers (Optional)
# If omitted, the engine uses deterministic semantic vectors and calibrated heuristics.
# ------------------------------------------------------------------------------
# OpenAI API Key for text-embedding-3-small (1536d) and GPT-4o synthesis
OPENAI_API_KEY=sk-proj-your-openai-api-key

# Google Gemini API Key for Gemini 1.5 Flash / Pro structured synthesis
GEMINI_API_KEY=AIzaSy-your-google-gemini-api-key

# ------------------------------------------------------------------------------
# Web Frontend & API Interconnect Configuration
# ------------------------------------------------------------------------------
# Public API endpoint URL consumed by Next.js apps/web
NEXT_PUBLIC_API_URL=http://localhost:8000

# Zero-Hallucination Hard Boundary threshold for pgvector similarity lookups
SIMILARITY_THRESHOLD=0.65
